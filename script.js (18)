/* ==========================================
   NEXUS 3.0 — MASTER MOTION ENGINE
   Vanilla JavaScript / No Libraries
========================================== */

(() => {
    "use strict";

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    const $ = (selector, parent = document) =>
        parent.querySelector(selector);

    const $$ = (selector, parent = document) =>
        [...parent.querySelectorAll(selector)];


    /* ======================================
       01. PAGE TRANSITIONS
    ====================================== */

    const transition = $(".page-transition");

    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            transition?.classList.add("page-ready");
        });
    });

    $$("a.page-link").forEach(link => {

        link.addEventListener("click", event => {

            const url = new URL(link.href);

            if (
                url.origin !== location.origin ||
                url.pathname === location.pathname ||
                event.ctrlKey ||
                event.metaKey ||
                event.shiftKey ||
                event.altKey ||
                event.button !== 0
            ) return;

            event.preventDefault();

            if (reducedMotion || !transition) {
                location.href = url.href;
                return;
            }

            transition.classList.remove("page-ready");
            transition.classList.add("is-leaving");

            window.setTimeout(() => {
                location.href = url.href;
            }, 850);

        });

    });


    /* ======================================
       02. SCROLL PROGRESS
    ====================================== */

    const pageProgress = $(".scroll-progress");

    function updatePageProgress() {

        const maxScroll =
            document.documentElement.scrollHeight -
            window.innerHeight;

        const progress = maxScroll > 0
            ? window.scrollY / maxScroll
            : 0;

        if (pageProgress) {
            pageProgress.style.width =
                `${progress * 100}%`;
        }

    }


    /* ======================================
       03. SMART NAVIGATION
    ====================================== */

    const navbar = $(".navbar");

    function updateNavbar() {

        navbar?.classList.toggle(
            "scrolled",
            window.scrollY > 50
        );

    }


    /* ======================================
       04. CINEMATIC REVEALS
    ====================================== */

    const revealElements = $$(".reveal");

    if (reducedMotion) {

        revealElements.forEach(element => {
            element.classList.add("visible");
        });

    } else if ("IntersectionObserver" in window) {

        const revealObserver = new IntersectionObserver(
            (entries, observer) => {

                entries.forEach(entry => {

                    if (entry.isIntersecting) {

                        entry.target.classList.add("visible");

                        observer.unobserve(entry.target);
                    }

                });

            },
            {
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px"
            }
        );

        revealElements.forEach(element => {
            revealObserver.observe(element);
        });

    }


    /* ======================================
       05. HORIZONTAL CINEMATIC TIMELINE
    ====================================== */

    const horizontalSection = $(".horizontal-scroll");
    const horizontalTrack = $(".horizontal-track");
    const panels = $$(".horizontal-panel");

    const horizontalFill = $(".horizontal-progress-fill");
    const currentCounter = $(".counter-current");

    let horizontalProgress = 0;
    let maxHorizontalTravel = 0;

// INERTIA ENGINE

let targetHorizontalX = 0;
let currentHorizontalX = 0;

const scrollSmoothness = 0.105;

let inertiaFrame = null;

function smoothHorizontalMotion() {

    if (!horizontalTrack || reducedMotion) return;

    const difference =
        targetHorizontalX - currentHorizontalX;

    if (Math.abs(difference) > 0.05) {

        currentHorizontalX +=
            difference * scrollSmoothness;

        horizontalTrack.style.transform =
            `translate3d(${currentHorizontalX}px, 0, 0)`;

        inertiaFrame =
            requestAnimationFrame(smoothHorizontalMotion);

    } else {

        currentHorizontalX = targetHorizontalX;

        horizontalTrack.style.transform =
            `translate3d(${currentHorizontalX}px, 0, 0)`;

        inertiaFrame = null;

    }

}

    function measureHorizontal() {

        if (!horizontalSection || !horizontalTrack) return;

        maxHorizontalTravel = Math.max(
            0,
            horizontalTrack.scrollWidth -
            window.innerWidth
        );

        // Vertical distance equals horizontal travel.
        horizontalSection.style.height =
            `${window.innerHeight + maxHorizontalTravel}px`;

        horizontalTrack.style.transform =
            "translate3d(0, 0, 0)";

    }

    function updateHorizontal() {

        if (!horizontalSection || !horizontalTrack) return;

        const rect = horizontalSection.getBoundingClientRect();

        const scrollDistance =
            horizontalSection.offsetHeight -
            window.innerHeight;

        const progress = scrollDistance > 0
            ? Math.max(
                0,
                Math.min(1, -rect.top / scrollDistance)
            )
            : 0;

        horizontalProgress = progress;

        // SMOOTH CINEMATIC SCROLL TARGET

const movement = progress * maxHorizontalTravel;

targetHorizontalX = -movement;

// Reduced-motion users get direct movement.
if (reducedMotion) {

    currentHorizontalX = targetHorizontalX;

    horizontalTrack.style.transform =
        `translate3d(${currentHorizontalX}px, 0, 0)`;

}

        // Progress bar

        if (horizontalFill) {
            horizontalFill.style.width =
                `${progress * 100}%`;
        }

        // Active panel

        const activeIndex = Math.min(
            panels.length - 1,
            Math.floor(progress * panels.length)
        );

        if (currentCounter) {
            currentCounter.textContent =
                String(activeIndex + 1).padStart(2, "0");
        }

        // Scrub-like panel animations

        panels.forEach((panel, index) => {

            const start = index / panels.length;
            const end = (index + 1) / panels.length;

            const center = (start + end) / 2;

            const distance = Math.abs(progress - center);

            const proximity = Math.max(
                0,
                1 - distance * panels.length * 2
            );

            const content = $(".panel-content", panel);
            const visual = $(".panel-visual", panel);

            if (!content) return;

            const opacity = .15 + proximity * .85;
            const translateY = 50 - proximity * 50;
            const scale = .96 + proximity * .04;

            content.style.opacity = opacity;

            content.style.transform =
                `translate3d(0, ${translateY}px, 0) scale(${scale})`;

            if (visual) {

                visual.style.opacity =
                    .15 + proximity * .85;

                visual.style.transform =
                    `translate3d(0, calc(-50% + ${-proximity * 15}px), 0) scale(${.85 + proximity * .15})`;

            }

        });

    }


    /* ======================================
       06. 3D CAMERA TRACKING
    ====================================== */

    const scene = $(".scene-3d");
    const core = $(".energy-core");

    let mouseX = 0;
    let mouseY = 0;

    let cameraX = 0;
    let cameraY = 0;

    if (!reducedMotion) {

        window.addEventListener("mousemove", event => {

            mouseX =
                (event.clientX / window.innerWidth - .5) * 2;

            mouseY =
                (event.clientY / window.innerHeight - .5) * 2;

        }, { passive: true });

    }

    function updateCamera() {

        cameraX += (mouseX - cameraX) * .045;
        cameraY += (mouseY - cameraY) * .045;

        if (scene && !reducedMotion) {

            scene.style.marginLeft =
                `${cameraX * 15}px`;

            scene.style.marginTop =
                `${cameraY * 15}px`;

        }

        if (core && !reducedMotion) {

            core.style.setProperty(
                "--camera-x",
                `${cameraY * -10}deg`
            );

            core.style.setProperty(
                "--camera-y",
                `${cameraX * 15}deg`
            );

        }

    }


    /* ======================================
       07. INTRO SCROLL DEPTH
    ====================================== */

    const intro = $(".intro");
    const introContent = $(".intro-content");

    function updateIntro() {

        if (!intro || !introContent) return;

        const rect = intro.getBoundingClientRect();

        const progress = Math.max(
            0,
            Math.min(
                1,
                -rect.top / Math.max(1, rect.height)
            )
        );

        if (!reducedMotion) {

            introContent.style.transform =
                `translate3d(0, ${progress * -100}px, 0)`;

            introContent.style.opacity =
                String(1 - progress * 1.2);

        }

    }


    /* ======================================
       08. PARTICLE ENGINE
    ====================================== */

    const canvas = $("#particles");
    const ctx = canvas?.getContext("2d");

    let particles = [];
    let canvasWidth = 0;
    let canvasHeight = 0;
    let dpr = 1;

    const pointer = {
        x: -1000,
        y: -1000
    };

    function resizeCanvas() {

        if (!canvas || !ctx) return;

        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvasWidth = window.innerWidth;
        canvasHeight = window.innerHeight;

        canvas.width = canvasWidth * dpr;
        canvas.height = canvasHeight * dpr;

        canvas.style.width = `${canvasWidth}px`;
        canvas.style.height = `${canvasHeight}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        createParticles();

    }

    class Particle {

        constructor() {

            this.x = Math.random() * canvasWidth;
            this.y = Math.random() * canvasHeight;

            this.size = Math.random() * 1.5 + .5;

            this.vx = (Math.random() - .5) * .35;
            this.vy = (Math.random() - .5) * .35;

            this.opacity = Math.random() * .45 + .1;

        }

        update() {

            this.x += this.vx;
            this.y += this.vy;

            const dx = this.x - pointer.x;
            const dy = this.y - pointer.y;

            const distance = Math.hypot(dx, dy);

            if (distance < 110 && distance > 0) {

                const force = (110 - distance) / 110;

                this.x += dx / distance * force * 1.3;
                this.y += dy / distance * force * 1.3;

            }

            if (this.x < 0) this.x = canvasWidth;
            if (this.x > canvasWidth) this.x = 0;

            if (this.y < 0) this.y = canvasHeight;
            if (this.y > canvasHeight) this.y = 0;

        }

        draw() {

            ctx.beginPath();

            ctx.arc(
                this.x,
                this.y,
                this.size,
                0,
                Math.PI * 2
            );

            ctx.fillStyle =
                `rgba(150, 170, 255, ${this.opacity})`;

            ctx.fill();

        }

    }

    function createParticles() {

        if (!ctx) return;

        const count = Math.min(
            85,
            Math.max(25, Math.floor(canvasWidth / 17))
        );

        particles = Array.from(
            { length: count },
            () => new Particle()
        );

    }

    function drawConnections() {

        const maxDistance = 105;

        for (let i = 0; i < particles.length; i++) {

            for (let j = i + 1; j < particles.length; j++) {

                const a = particles[i];
                const b = particles[j];

                const distance = Math.hypot(
                    a.x - b.x,
                    a.y - b.y
                );

                if (distance < maxDistance) {

                    const opacity =
                        (1 - distance / maxDistance) * .12;

                    ctx.beginPath();

                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);

                    ctx.strokeStyle =
                        `rgba(130, 150, 255, ${opacity})`;

                    ctx.lineWidth = .7;
                    ctx.stroke();

                }

            }

        }

    }

    function drawParticles() {

        if (!ctx) return;

        ctx.clearRect(0, 0, canvasWidth, canvasHeight);

        particles.forEach(particle => {

            particle.update();
            particle.draw();

        });

        drawConnections();

    }


    /* ======================================
       09. MASTER ANIMATION LOOP
    ====================================== */

    let framePending = false;

    function updateFrame() {

        updatePageProgress();
        updateNavbar();
        updateHorizontal();
        // Start or continue the smooth interpolation.

if (
    !reducedMotion &&
    Math.abs(targetHorizontalX - currentHorizontalX) > 0.05 &&
    inertiaFrame === null
) {
    inertiaFrame =
        requestAnimationFrame(smoothHorizontalMotion);
}
        
        updateIntro();

        if (!reducedMotion) {

            updateCamera();
            drawParticles();

        }

        framePending = false;

    }

    function requestFrame() {

        if (!framePending) {

            framePending = true;

            requestAnimationFrame(updateFrame);

        }

    }


    /* ======================================
       10. EVENT INITIALIZATION
    ====================================== */

    window.addEventListener("scroll", requestFrame, {
        passive: true
    });

    window.addEventListener("resize", () => {

        measureHorizontal();
        resizeCanvas();
        requestFrame();

    }, { passive: true });

    window.addEventListener("mousemove", event => {

        pointer.x = event.clientX;
        pointer.y = event.clientY;

    }, { passive: true });

    window.addEventListener("mouseout", event => {

        if (!event.relatedTarget) {
            pointer.x = -1000;
            pointer.y = -1000;
        }

    });

    measureHorizontal();
    resizeCanvas();
    requestFrame();

    // Refresh measurements after page fonts and layout settle.

    window.addEventListener("load", () => {

        measureHorizontal();
        requestFrame();

    });
/* ==========================================
   NEXUS 3.1 — MAGNETIC BUTTON INTERACTION
========================================== */

const magneticButtons = $$(".nav-button, .intro-button");

if (!reducedMotion) {

    magneticButtons.forEach(button => {

        button.addEventListener("mousemove", event => {

            const rect = button.getBoundingClientRect();

            const x =
                event.clientX - rect.left - rect.width / 2;

            const y =
                event.clientY - rect.top - rect.height / 2;

            button.style.transform =
                `translate3d(${x * .08}px, ${y * .12 - 3}px, 0)`;

        });

        button.addEventListener("mouseleave", () => {

            button.style.transform = "";

        });

    });

}


/* ==========================================
   3D OBJECT PARALLAX
========================================== */

const floatingObjects = $$(".floating-object, .floating-crystal");

if (!reducedMotion) {

    let objectX = 0;
    let objectY = 0;

    let objectTargetX = 0;
    let objectTargetY = 0;

    window.addEventListener("mousemove", event => {

        objectTargetX =
            (event.clientX / window.innerWidth - .5) * 18;

        objectTargetY =
            (event.clientY / window.innerHeight - .5) * 18;

    }, { passive: true });

    function animateFloatingObjects() {

        objectX += (objectTargetX - objectX) * .035;
        objectY += (objectTargetY - objectY) * .035;

        floatingObjects.forEach((object, index) => {

            const factor = (index % 3 + 1) * .25;

            object.style.translate =
                `${objectX * factor}px ${objectY * factor}px`;

        });

        requestAnimationFrame(animateFloatingObjects);

    }

    animateFloatingObjects();

}
})();